<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>Dominaite.MerchantSdk</AssemblyName>
    <RootNamespace>Dominaite.MerchantSdk</RootNamespace>
    <Version>0.3.0</Version>
    <Description>Server-side .NET client for the Dominaite merchant API (hosted checkout sessions and stored payment methods).</Description>
    <Authors>Dominaite</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/dominaite/merchant-sdk-dotnet</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageId>Dominaite.MerchantSdk</PackageId>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!-- No PackageReference on purpose: System.Text.Json and HMACSHA256 are in-box on net8.0. -->

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
